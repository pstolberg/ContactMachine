{
  "expo": {
    "name": "ContactMachine",
    "slug": "contact-machine",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.contactmachine.app",
      "infoPlist": {
        "NSContactsUsageDescription": "ContactMachine imports your device contacts so you can manage relationships.",
        "NSMicrophoneUsageDescription": "ContactMachine uses the microphone to record voice notes about your contacts."
      }
    },
    "android": {
      "package": "com.contactmachine.app",
      "permissions": [
        "READ_CONTACTS",
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6366F1"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "ContactMachine needs microphone access for voice notes."
        }
      ],
      "expo-contacts",
      "expo-secure-store"
    ]
  }
}
